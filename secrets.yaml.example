# Copy this file to secrets.yaml and replace every CHANGE_ME value.
# secrets.yaml is ignored by Git (see .gitignore).
#
# API encryption key: generate a 32-byte base64 key with:
#   openssl rand -base64 32
#
# These names must match the !secret references in the YAML files.

wifi_ssid: "CHANGE_ME_WIFI_SSID"
wifi_password: "CHANGE_ME_WIFI_PASSWORD"

fallback_ap_ssid: "CHANGE_ME_FALLBACK_AP_SSID"
fallback_ap_password: "CHANGE_ME_FALLBACK_AP_PASSWORD"

# Also used for encrypted OTA (ota: encryption:); no separate OTA password.
api_encryption_key: "CHANGE_ME_BASE64_32_BYTE_KEY"
